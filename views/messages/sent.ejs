<% locals.path = '/messages/sent'; %>

<div class="page-header">
  <div>
    <h1>✉️ Sent Messages</h1>
    <p class="text-muted"><%= messages.length %> sent</p>
  </div>
  <a href="/messages/compose" class="btn btn-primary">✏️ Compose</a>
</div>

<% if (locals.success === 'sent') { %>
  <div class="alert alert-success">✅ Message sent successfully!</div>
<% } %>

<div class="tabs mb-4">
  <a href="/messages" class="tab">Inbox</a>
  <a href="/messages/sent" class="tab active">Sent</a>
</div>

<div class="card">
  <div class="card-body">
    <% if (messages.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">📨</div>
        <h3>No sent messages</h3>
        <p>Messages you send will appear here.</p>
      </div>
    <% } else { %>
      <% messages.forEach(m => { %>
        <div class="msg-list-item" style="border:1px solid var(--gray-200);border-radius:var(--radius);margin-bottom:0.5rem;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:0.85rem 1.25rem;cursor:pointer;"
               onclick="toggleMsg(event, 'sent-<%= m.id %>')">
            <div style="display:flex;align-items:center;gap:0.75rem;flex:1;min-width:0;">
              <div style="min-width:0;">
                <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.15rem;">
                  <strong style="font-size:0.95rem;"><%= m.subject %></strong>
                </div>
                <div class="text-sm text-muted">
                  To <strong><%= m.receiver_name %></strong>
                  <span class="tag tag-gray" style="font-size:0.7rem;"><%= m.receiver_role %></span>
                  &nbsp;·&nbsp; <%= new Date(m.created_at).toLocaleString() %>
                </div>
              </div>
            </div>
            <button type="button" class="btn btn-outline btn-sm" style="flex-shrink:0;margin-left:1rem;">
              <span class="toggle-icon-sent-<%= m.id %>">▼</span> View
            </button>
          </div>
          <div id="sent-<%= m.id %>" style="display:none;padding:0 1.25rem 1rem 1.25rem;border-top:1px solid var(--gray-100);">
            <div style="background:white;border-radius:var(--radius);padding:1rem;margin-top:0.75rem;white-space:pre-wrap;line-height:1.7;color:var(--gray-700);">
              <%= m.content %>
            </div>
            <div class="flex gap-1 mt-3">
              <a href="/profile/<%= m.receiver_id %>" class="btn btn-outline btn-sm">👤 View Profile</a>
              <a href="/messages/compose?to=<%= m.receiver_id %>" class="btn btn-outline btn-sm">✏️ Message Again</a>
              <a href="/messages/<%= m.id %>" class="btn btn-primary btn-sm">↗ Open</a>
              <form method="POST" action="/messages/<%= m.id %>/delete" style="display:inline;margin-left:auto;">
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Delete?')">🗑 Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<script>
function toggleMsg(e, id) {
  e.stopPropagation();
  const el = document.getElementById(id);
  const icon = document.querySelector('.toggle-icon-' + id);
  if (el.style.display === 'none') {
    el.style.display = 'block';
    if (icon) icon.textContent = '▲';
  } else {
    el.style.display = 'none';
    if (icon) icon.textContent = '▼';
  }
}
</script>
